@@ -75,6 +75,11 @@
 {%- set mns = namespace(list=[]) -%}
 {%- for msg in messages -%}
     {%- set content = msg.get("content") -%}
+    {%- if msg.role == "user" and msg.get("content_blocks") is not none -%}
+        {%- set content = msg.content_blocks -%}
+    {%- elif msg.role == "tool" and msg.get("content_blocks") and content is not string -%}
+        {%- set content = msg.content_blocks -%}
+    {%- endif -%}
     {%- set is_blocks = content is iterable and content is not string and content is not mapping -%}
     {%- if content is string and IMG in content -%}
         {{- raise_exception("Message content contains image special token " ~ IMG ~ ". Images should be provided as image content blocks.") -}}
@@ -151,10 +156,19 @@
 {%- endfor -%}
 {%- set msgs = sns.list -%}
 
-{#- Mid-conversation system messages count as user turns. Tools anywhere disable drop_thinking. -#}
+{#- Mid-conversation system messages count as user turns; user messages holding only tool results do not.
+    Tools anywhere disable drop_thinking. -#}
 {%- set state = namespace(last_user=-1, has_tools=false) -%}
 {%- for m in msgs -%}
-    {%- if m.role == "user" or (m.role == "system" and loop.index0 > 0) -%}{%- set state.last_user = loop.index0 -%}{%- endif -%}
+    {%- set starts_turn = (m.role == "system" and loop.index0 > 0) -%}
+    {%- if m.role == "user" -%}
+        {%- set turn = namespace(found=not m.content_blocks) -%}
+        {%- for b in m.content_blocks or [] -%}

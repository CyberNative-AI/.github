+        {%- endfor -%}
+        {%- set starts_turn = turn.found -%}
+    {%- endif -%}
+    {%- if starts_turn -%}{%- set state.last_user = loop.index0 -%}{%- endif -%}
     {%- if m.get("tools") -%}{%- set state.has_tools = true -%}{%- endif -%}

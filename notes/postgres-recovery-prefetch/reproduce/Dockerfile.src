FROM postgres@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6
RUN apt-get update && apt-get install -y --no-install-recommends build-essential bison flex zlib1g-dev pkg-config patch && rm -rf /var/lib/apt/lists/*
COPY postgresql-18.6.tar.bz2 v3-0001.patch /src/
RUN cd /src && tar xjf postgresql-18.6.tar.bz2 && cp -a postgresql-18.6 pgp && cd pgp && patch -p1 < /src/v3-0001.patch \
 && cd /src/postgresql-18.6 && ./configure --prefix=/opt/pgv --without-icu --without-readline >/dev/null && make -j4 -s >/dev/null && make -s install >/dev/null \
 && cd /src/pgp && ./configure --prefix=/opt/pgp --without-icu --without-readline >/dev/null && make -j4 -s >/dev/null && make -s install >/dev/null \
 && rm -rf /src/postgresql-18.6 /src/pgp
